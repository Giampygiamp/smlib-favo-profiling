+        SmExtent3d sLoopBox;
+        bool bBoxOk = true;
+        for ( ULONG kk = 0; kk < lNumEUs; kk++ )
+          {
+            SmCurve *pUVc = NULL;
+            if ( apEUs[kk]->GetOrCreateUVTrimCurve( pUVc ) != SM_SUCCESS || pUVc == NULL )
+              { bBoxOk = false; break; }
+            SmExtent3d sBox;
+            if ( pUVc->CalculateBoundingBox( apEUs[kk]->GetEdge()->GetInterval(), &sBox ) != SM_SUCCESS )
+              { bBoxOk = false; break; }
+            sLoopBox.AddPoint3d( sBox.GetMin() );
+            sLoopBox.AddPoint3d( sBox.GetMax() );
+          }
+        if ( bBoxOk )
+          {
+            const double dSize   = smos_Max( sLoopBox.XLength(), sLoopBox.YLength() );
+            const double dMargin = 0.05 * dSize + 100.0 * dTolUV;
+            const SmPoint2d sDomMin = sSrfUVDomain.GetMin();
+            const SmPoint2d sDomMax = sSrfUVDomain.GetMax();
+            const bool bStrictlyInside =
+                 sLoopBox.GetMin(0) > sDomMin.x + dMargin && sLoopBox.GetMax(0) < sDomMax.x - dMargin
+              && sLoopBox.GetMin(1) > sDomMin.y + dMargin && sLoopBox.GetMax(1) < sDomMax.y - dMargin;
+            if ( bStrictlyInside
+              && (   crUVPoint.x < sLoopBox.GetMin(0) - dMargin || crUVPoint.x > sLoopBox.GetMax(0) + dMargin
+                  || crUVPoint.y < sLoopBox.GetMin(1) - dMargin || crUVPoint.y > sLoopBox.GetMax(1) + dMargin ) )
+              { return SM_POC_OUTSIDE; }
+          }
+      }
+  }
